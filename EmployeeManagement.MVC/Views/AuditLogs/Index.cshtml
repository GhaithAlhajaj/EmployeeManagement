@model IReadOnlyList<EmployeeManagement.MVC.ViewModels.AuditLogViewModel>

@{
    ViewData["Title"] = "Audit history";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h2 class="mb-1">Audit history</h2>
        <p class="text-muted mb-0">Recent successful changes made through the API.</p>
    </div>
    <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
        <label for="limit" class="form-label mb-0">Entries</label>
        <select id="limit" name="limit" class="form-select">
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
        </select>
        <button type="submit" class="btn btn-outline-primary">Apply</button>
    </form>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="status">@error</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No audit events have been recorded yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Time (UTC)</th>
                    <th>Actor</th>
                    <th>Operation</th>
                    <th>Path</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td>@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@entry.ActorEmail</td>
                        <td><span class="badge text-bg-light">@entry.Method</span></td>
                        <td><code>@entry.Path</code></td>
                        <td>@entry.StatusCode</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
