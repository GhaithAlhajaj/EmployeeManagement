
@model IEnumerable<EmployeeManagement.MVC.ViewModels.DepartmentViewModel>

@{
    ViewData["Title"] = "Departments";
}

<div class="container-fluid py-3">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Departments</h2>
            <p class="text-muted mb-0">Manage your organization structure and team assignments.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary px-4">
                <i class="bi bi-plus-lg me-2"></i>
                Add Department
            </a>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-building text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Departments</div>
                        <h4 class="fw-bold mb-0">@Model.Count()</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 p-3">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Active Departments</div>
                        <h4 class="fw-bold mb-0">@Model.Count(d => d.IsActive)</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 p-3">
                        <i class="bi bi-people text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Employees</div>
                        <h4 class="fw-bold mb-0">@Model.Sum(d => d.EmployeeCount)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0">Department Directory</h5>
        </div>

        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Department</th>
                                <th>Description</th>
                                <th>Employees</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var department in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-3 bg-primary bg-opacity-10 p-2">
                                                <i class="bi bi-building text-primary"></i>
                                            </div>
                                            <span class="fw-semibold">@department.Name</span>
                                        </div>
                                    </td>

                                    <td class="text-muted">
                                        @(string.IsNullOrWhiteSpace(department.Description) ? "No description" : department.Description)
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-people me-1"></i>
                                            @department.EmployeeCount
                                        </span>
                                    </td>

                                    <td>
                                        @if (department.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">Inactive</span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-sm btn-light" title="View details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-light text-primary" title="Edit department">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <a asp-action="Delete" asp-route-id="@department.Id" class="btn btn-sm btn-light text-danger" title="Delete department">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-building display-4 text-muted"></i>
                    <h5 class="fw-bold mt-3">No departments yet</h5>
                    <p class="text-muted mb-3">Start by creating your first department.</p>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-2"></i>
                            Create Department
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
