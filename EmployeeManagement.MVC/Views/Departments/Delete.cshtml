@model EmployeeManagement.MVC.ViewModels.DepartmentViewModel

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1 text-danger">Delete Department</h2>
                            <p class="text-muted mb-0">This action cannot be undone.</p>
                        </div>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Are you sure you want to delete <strong>@Model.Name</strong>?
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="rounded-3 bg-light p-3 h-100">
                                <div class="text-muted small text-uppercase">Department</div>
                                <div class="fw-bold fs-5 mt-1">@Model.Name</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="rounded-3 bg-light p-3 h-100">
                                <div class="text-muted small text-uppercase">Employee Count</div>
                                <div class="fw-bold fs-5 mt-1">@Model.EmployeeCount</div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="rounded-3 bg-light p-3">
                                <div class="text-muted small text-uppercase">Description</div>
                                <p class="mb-0 mt-2">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i> Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
