@model EmployeeManagement.MVC.ViewModels.DepartmentViewModel

@{
    ViewData["Title"] = "Department Details";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1">Department Details</h2>
                            <p class="text-muted mb-0">View full department information.</p>
                        </div>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="rounded-3 bg-light p-3 h-100">
                                <div class="text-muted small text-uppercase">Department Name</div>
                                <div class="fw-bold fs-5 mt-1">@Model.Name</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="rounded-3 bg-light p-3 h-100">
                                <div class="text-muted small text-uppercase">Status</div>
                                <div class="mt-2">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">Inactive</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="rounded-3 bg-light p-3">
                                <div class="text-muted small text-uppercase">Description</div>
                                <p class="mb-0 mt-2">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="rounded-3 bg-light p-3 h-100">
                                <div class="text-muted small text-uppercase">Employee Count</div>
                                <div class="fw-bold fs-5 mt-1">@Model.EmployeeCount</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="rounded-3 bg-light p-3 h-100">
                                <div class="text-muted small text-uppercase">Department ID</div>
                                <div class="fw-bold fs-5 mt-1">@Model.Id</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="EmployeeReport" asp-route-id="@Model.Id" class="btn btn-outline-primary px-4">
                            <i class="bi bi-people me-2"></i> Employee report
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                                <i class="bi bi-pencil me-2"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i> Delete
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
