@model EmployeeManagement.MVC.Models.Account.CreateManagedUserViewModel

@{
    ViewData["Title"] = "Create user";
}

<div class="page-heading">
    <div>
        <h2>Create user</h2>
        <p class="text-muted">Add an account to the organization.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

<section class="content-panel" style="max-width: 720px;">
    <form asp-action="CreateUser" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Use 8 or more characters with uppercase and lowercase letters, a number, and a symbol.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Role" class="form-label"></label>
                @if (User.IsInRole("Admin"))
                {
                    <select asp-for="Role" class="form-select">
                        <option value="Employee">Employee</option>
                        <option value="HR">HR</option>
                    </select>
                }
                else
                {
                    <input type="hidden" asp-for="Role" value="Employee" />
                    <input class="form-control" value="Employee" readonly />
                }
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create account</button>
            <a asp-action="MyAccount" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}