@model EmployeeManagement.MVC.ViewModels.EmployeeStatisticsViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1">Dashboard</h2>
        <p class="text-muted mb-0">Current workforce overview</p>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="status">@error</div>
}

<div class="row g-3">
    <div class="col-md-4">
        <section class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Total employees</div>
                <div class="fs-2 fw-semibold">@Model.TotalEmployees</div>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Active employees</div>
                <div class="fs-2 fw-semibold text-success">@Model.ActiveEmployees</div>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Average salary</div>
                <div class="fs-2 fw-semibold">@Model.AverageSalary.ToString("C0")</div>
            </div>
        </section>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-primary">Open employee directory</a>
    <span class="text-muted ms-3">@Model.InactiveEmployees inactive</span>
</div>
