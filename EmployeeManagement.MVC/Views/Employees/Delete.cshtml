
@model EmployeeManagement.MVC.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Delete Employee";
}

<h2 class="text-danger mb-3">Delete Employee</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this employee?
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@Model.FirstName @Model.LastName</h5>
        <p>Email: @Model.Email</p>
        <p>Department: @Model.DepartmentName</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
