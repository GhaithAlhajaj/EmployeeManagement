
@model EmployeeManagement.MVC.ViewModels.EmployeeDirectoryViewModel

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employees</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
    {
        <a asp-action="Create" class="btn btn-primary">Add Employee</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-lg-4 col-md-6">
        <label for="search" class="form-label">Search</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Name or email" />
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
    {
        <div class="col-lg-3 col-md-6">
            <label for="departmentId" class="form-label">Department</label>
            <select id="departmentId" name="departmentId" class="form-select">
                <option value="">All departments</option>
                @foreach (var department in Model.Departments)
                {
                    <option value="@department.Id" selected="@(Model.DepartmentId == department.Id)">@department.Name</option>
                }
            </select>
        </div>
    }
    <div class="col-lg-2 col-md-4">
        <label for="isActive" class="form-label">Status</label>
        <select id="isActive" name="isActive" class="form-select">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-lg-1 col-md-2">
        <label for="pageSize" class="form-label">Rows</label>
        <select id="pageSize" name="pageSize" class="form-select">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="20" selected="@(Model.PageSize == 20)">20</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
    </div>
    <div class="col-lg-2 col-md-6 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">@Model.TotalCount employee(s)</span>
    <span class="text-muted">Page @Model.Page of @Model.TotalPages</span>
</div>

<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.FirstName @employee.LastName</td>
                <td>@employee.Email</td>
                <td>@employee.DepartmentName</td>
                <td>@employee.Salary.ToString("N2")</td>
                <td>
                    @if (employee.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@employee.Id"
                       class="btn btn-sm btn-info">Details</a>

                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                          {
                                <a asp-action="Edit"
                                    asp-route-id="@employee.Id"
                                    class="btn btn-sm btn-warning">Edit</a>

                                <a asp-action="Delete"
                                    asp-route-id="@employee.Id"
                                    class="btn btn-sm btn-danger">Delete</a>
                          }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (!Model.Employees.Any())
{
    <div class="alert alert-info">
        No employees match the current filters.
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Employee pages">
        <ul class="pagination justify-content-end">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-departmentId="@Model.DepartmentId" asp-route-isActive="@Model.IsActive" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-departmentId="@Model.DepartmentId" asp-route-isActive="@Model.IsActive" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}
